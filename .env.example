# Settings for the Docker stack. Copy to .env, or let `make up` do it.
#
# This file is read by both Compose and the Makefile, which parse it slightly
# differently, so two rules keep them agreeing: comments stay on their own
# lines, and values are never quoted. A trailing comment or a pair of quotes
# ends up inside the value.

# Where the application checkout is, relative to this directory (or absolute).
# Left blank on purpose: `make up` fills it in with ../arks-service if there
# is a checkout beside this one, and ./src/arks-service (gitignored) if
# not. If nothing is at that path, the application is cloned into it; a
# checkout that is already there is never touched.
ARKS_SRC=

# Only used for that clone. ARKS_REPO blank means the same host and
# organisation this repository was cloned from, so the credentials that worked
# for it work again. ARKS_REF is a branch or tag; blank means the default branch.
ARKS_REPO=
ARKS_REF=

# Optional plugin: the arks-cli command line (createcollection, mint, bind,
# unbind, bulk_bind, ark_stats). Point ARKS_PLUGIN_SRC at an arks-cli checkout
# to build it into the image, enable it with ARKS_PLUGINS, then `make install`.
# Both blank (the default): the image is arks-service alone, and those six
# commands do not exist in it. The plugin is baked into the image, so any
# change to these two lines needs `make install`; a plain `make up` keeps an
# image that already exists.
#ARKS_PLUGIN_SRC=../arks-cli
#ARKS_PLUGINS=arks_cli

# Host port the stack listens on.
ARKS_PORT=8000

# Read only with docker-compose.remote-proxy.yml, which has no default for it:
# this host's private address, the one the proxy on the other machine connects
# to. web is published there and nowhere else.
ARKS_BIND_ADDRESS=

# Leave false. The stack is not a debugging session, and DEBUG
# would expose settings through error pages.
DJANGO_DEBUG=false

# Extra hostnames the app should answer on, comma-separated. localhost and
# 127.0.0.1 are always allowed and cannot be removed here: the container
# healthcheck asks for localhost, and Django answers 400 to a hostname it does
# not know, which would leave the stack permanently unhealthy.
ARKS_EXTRA_HOSTS=

# Left blank on purpose: `make up` generates one and writes it back here.
# It is never overwritten once set.
DJANGO_SECRET_KEY=

# Which database and broker the stack runs, as a list of Compose files.
# Commented out means a PostgreSQL container and a Valkey container: the
# development default. Uncomment one line to change that; comment it out again
# to go back. Each database container keeps its own volume, so switching
# destroys neither one's data. Every override needs Docker Compose 2.24.4 or
# later.
#
# MySQL 8.0 in a container, the engine production uses:
#COMPOSE_FILE=docker-compose.yml:docker-compose.mysql.yml
#
# Production: an existing MySQL server (fill in the MySQL block below), with
# the broker in a container:
#COMPOSE_FILE=docker-compose.yml:docker-compose.external-db.yml
#
# Production: an existing MySQL server and an existing Valkey or Redis server
# (fill in the broker block below too). Neither container is started:
#COMPOSE_FILE=docker-compose.yml:docker-compose.external-db.yml:docker-compose.external-broker.yml
#
# Production behind Apache with TLS on the same host, the full production set:
# web listens on 127.0.0.1 only and the cookies are Secure. Set ARKS_EXTRA_HOSTS
# to the public hostname as well.
#COMPOSE_FILE=docker-compose.yml:docker-compose.external-db.yml:docker-compose.external-broker.yml:docker-compose.proxy.yml
#
# Production behind a TLS proxy on ANOTHER machine (nginx on a gateway): web
# listens on ARKS_BIND_ADDRESS only and the cookies are Secure. Instead of
# docker-compose.proxy.yml, never with it. Set ARKS_BIND_ADDRESS below and
# ARKS_EXTRA_HOSTS, and firewall the port to the proxy (see the file's header).
#COMPOSE_FILE=docker-compose.yml:docker-compose.external-db.yml:docker-compose.external-broker.yml:docker-compose.remote-proxy.yml
#
# A MySQL container behind the same proxy, for a staging VM:
#COMPOSE_FILE=docker-compose.yml:docker-compose.mysql.yml:docker-compose.proxy.yml

# Passwords and user names below: for a container this stack runs (PostgreSQL,
# MySQL, the broker) use letters and digits only. Each value is handed to the
# server raw and to the application inside a URL, so a character that needs
# percent-encoding in one is wrong in the other. For an external server
# (docker-compose.external-db.yml, docker-compose.external-broker.yml) the
# value only ever enters a URL, so percent-encode anything that is not a
# letter or digit: @ as %40, / as %2F, # as %23, % as %25, : as %3A. Either
# way, Compose interpolates $ inside a value: write a literal $ as $$.

# --- PostgreSQL container (the default database) ---------------------------
# Applied the one time the container initialises its volume, so set them
# before the first `make up`; changing them later needs `make clean` first, or
# the application can no longer log in. Only reachable from inside the Compose
# network unless you publish the port yourself.
POSTGRES_DB=ark
POSTGRES_USER=ark
POSTGRES_PASSWORD=ark

# --- MySQL --------------------------------------------------------------------
# The database, account and password, for either kind of MySQL:
# - the container (docker-compose.mysql.yml) creates them the one time it
#   initialises its volume, as above. MYSQL_ROOT_PASSWORD, for the container
#   only, defaults to MYSQL_PASSWORD.
# - an external server (docker-compose.external-db.yml) must already have
#   them: the database must exist and MYSQL_USER must be allowed to create
#   tables in it, because web runs the migrations on every start.
MYSQL_DATABASE=ark
MYSQL_USER=ark
MYSQL_PASSWORD=ark
#MYSQL_ROOT_PASSWORD=
#
# The external server's address, read only with docker-compose.external-db.yml.
# MYSQL_HOST has no default: Compose refuses to start without it. It is seen
# from inside a container, so localhost is the container itself.
MYSQL_HOST=
MYSQL_PORT=3306

# --- Broker and cache: Valkey or Redis ----------------------------------------
# The Celery queue for bulk binds and the shared cache. The broker container
# runs Valkey; to run Redis instead:
#BROKER_IMAGE=redis:7-alpine
# Any image speaking the Redis protocol and providing redis-cli works; the
# application is the same either way. Switching loses only redirect counts not
# yet written to the database, so on a live system run
# `make manage ARGS="flush_counters"` first, then `make down && make up`.
#
# BROKER_PASSWORD is what clients must authenticate with. `make up` generates
# one when this file has no BROKER_PASSWORD line at all, and the broker
# container enforces it on every start, so changing it takes effect with
# `make down && make up`. With an external server it is that server's password instead: replace
# the generated value. A line set deliberately blank, BROKER_PASSWORD= , turns
# authentication off and is left blank.
#BROKER_PASSWORD=
#
# An external Valkey or Redis server, read only with
# docker-compose.external-broker.yml. BROKER_HOST has no default. Leave
# BROKER_USERNAME blank to log in as the server's default user with just the
# password; set it for a named account (ACL user), as managed services hand
# out. The queue and the cache use two database numbers, which must differ.
# For TLS set BROKER_SCHEME=rediss and BROKER_URL_OPTIONS=?ssl_cert_reqs=required
BROKER_HOST=
BROKER_PORT=6379
BROKER_USERNAME=
BROKER_QUEUE_DB=0
BROKER_CACHE_DB=1
BROKER_SCHEME=redis
BROKER_URL_OPTIONS=

# The administrator account `make up` creates. The password is generated
# and written back here if left blank, and printed on the run that creates the
# account. An account that already exists keeps its own password.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.org
DJANGO_SUPERUSER_PASSWORD=

# Largest number of ARKs one mint may create. 0 removes the cap. The mint form
# runs inside the web request, so a very large batch keeps the browser (and a
# proxy in front) waiting; bulk bind mints in the worker instead.
MINT_MAX_PER_REQUEST=10000

# Operator-supplied landing and error pages (index.html, 403.html, 404.html,
# 500.html and their assets), as a directory on this host. Blank means off: the
# built-in landing page and Django's plain error pages. The directory is mounted
# read-only into web; a starting kit is docs/fallback-example/ in the
# application repository. Changes to the files show within a minute.
FALLBACK_DIR=

# --- Tuning and production settings --------------------------------------------
# Each is passed to web, worker and scheduler. Commented out means the default
# shown, which docker-compose.yml supplies; README.md describes each one.
#
# Behind a proxy: X-Forwarded-For is trusted (the login throttle counts per
# client). Defaults to true with docker-compose.proxy.yml and false without it,
# docker-compose.remote-proxy.yml included: there, set it to true once only the
# proxy can reach the port.
#TRUST_FORWARDED_FOR=false
# Comma-separated https:// origins allowed to post forms, only when that is a
# different hostname from the one serving the page.
#DJANGO_CSRF_TRUSTED_ORIGINS=
# Seconds of HSTS. Leave 0 until TLS is known good, then raise it.
#SECURE_HSTS_SECONDS=0
# Only when the staff hostname differs from the resolver's, e.g.
# https://ark.digital.utsc.utoronto.ca
#ARK_PUBLIC_BASE_URL=
#
# Database connections: seconds a connection is reused, and the MySQL
# connect/read/write timeouts in seconds.
#DB_CONN_MAX_AGE=60
#DB_CONNECT_TIMEOUT=5
#DB_READ_TIMEOUT=60
#DB_WRITE_TIMEOUT=60
# Seconds to connect to, and wait on, the cache (Valkey/Redis) before giving up.
# Short, so a broker outage slows requests down rather than hanging them.
#CACHE_SOCKET_TIMEOUT=0.5
#
# Bulk bind: rows and bytes per upload (50 MB), and days to keep finished jobs
# and their files (0 keeps them forever).
#BULK_BIND_MAX_ROWS=100000
#BULK_BIND_MAX_BYTES=52428800
#BULK_BIND_RETENTION_DAYS=0
# Seconds a background job may run before Celery stops it.
#CELERY_TASK_TIME_LIMIT=3600
#
# /manifest: seconds per read and per whole fetch (keep the total under
# gunicorn's 60 s timeout), and fetches at once per web process.
#MANIFEST_FETCH_TIMEOUT=30
#MANIFEST_TOTAL_TIMEOUT=30
#MANIFEST_MAX_CONCURRENT=4
#
# Staff pages on large collections: seconds between refreshes of the stored
# collection counts; the most ARKs a list may hold and still offer the
# Redirects and Elements sorts; and the largest export the staff interface
# serves itself (above it, it shows the equivalent export_arks command).
#COLLECTION_STATS_SECONDS=300
#SORT_SUBQUERY_MAX_ROWS=50000
#EXPORT_SYNC_MAX_ROWS=100000
#
# Memory ceilings per container (Docker sizes: 512m, 1g, ...). The database
# containers have none.
#WEB_MEM_LIMIT=1g
#WORKER_MEM_LIMIT=2g
#SCHEDULER_MEM_LIMIT=256m
#BROKER_MEM_LIMIT=256m
# Broker's own memory ceiling; keep it below BROKER_MEM_LIMIT.
#BROKER_MAXMEMORY=200mb
