# Settings for the Docker stack. Copy to .env, or let `make up` do it.
#
# This file is read by both Compose and the Makefile, which parse it slightly
# differently, so two rules keep them agreeing: comments stay on their own
# lines, and values are never quoted. A trailing comment or a pair of quotes
# ends up inside the value.

# Where the application checkout is, relative to this directory (or absolute).
# Left blank on purpose: `make up` fills it in with ../arks-service if there
# is a checkout beside this one, and ./src/arks-service (gitignored) if
# not. If nothing is at that path, the application is cloned into it; a
# checkout that is already there is never touched.
ARKS_SRC=

# Only used for that clone. ARKS_REPO blank means the same host and
# organisation this repository was cloned from, so the credentials that worked
# for it work again. ARKS_REF is a branch or tag; blank means the default branch.
ARKS_REPO=
ARKS_REF=

# Host port the stack listens on.
ARKS_PORT=8000

# Leave false. The stack is not a debugging session, and DEBUG
# would expose settings through error pages.
DJANGO_DEBUG=false

# Extra hostnames the app should answer on, comma-separated. localhost and
# 127.0.0.1 are always allowed and cannot be removed here: the container
# healthcheck asks for localhost, and Django answers 400 to a hostname it does
# not know, which would leave the stack permanently unhealthy.
ARKS_EXTRA_HOSTS=

# Left blank on purpose: `make up` generates one and writes it back here.
# It is never overwritten once set.
DJANGO_SECRET_KEY=

# Which database and broker the stack runs, as a list of Compose files.
# Commented out means a PostgreSQL container and a Valkey container: the
# development default. Uncomment one line to change that; comment it out again
# to go back. Each database container keeps its own volume, so switching
# destroys neither one's data. Every override needs Docker Compose 2.24.4 or
# later.
#
# MySQL 8.0 in a container, the engine production uses:
#COMPOSE_FILE=docker-compose.yml:docker-compose.mysql.yml
#
# Production: an existing MySQL server (fill in the MySQL block below), with
# the broker in a container:
#COMPOSE_FILE=docker-compose.yml:docker-compose.external-db.yml
#
# Production: an existing MySQL server and an existing Valkey or Redis server
# (fill in the broker block below too). Neither container is started:
#COMPOSE_FILE=docker-compose.yml:docker-compose.external-db.yml:docker-compose.external-broker.yml

# Passwords and user names below are substituted into URLs. Use letters and
# digits, or percent-encode anything else: @ as %40, / as %2F, # as %23,
# % as %25, : as %3A.

# --- PostgreSQL container (the default database) ---------------------------
# Applied the one time the container initialises its volume, so set them
# before the first `make up`; changing them later needs `make clean` first, or
# the application can no longer log in. Only reachable from inside the Compose
# network unless you publish the port yourself.
POSTGRES_DB=ark
POSTGRES_USER=ark
POSTGRES_PASSWORD=ark

# --- MySQL --------------------------------------------------------------------
# The database, account and password, for either kind of MySQL:
# - the container (docker-compose.mysql.yml) creates them the one time it
#   initialises its volume, as above. MYSQL_ROOT_PASSWORD, for the container
#   only, defaults to MYSQL_PASSWORD.
# - an external server (docker-compose.external-db.yml) must already have
#   them: the database must exist and MYSQL_USER must be allowed to create
#   tables in it, because web runs the migrations on every start.
MYSQL_DATABASE=ark
MYSQL_USER=ark
MYSQL_PASSWORD=ark
#MYSQL_ROOT_PASSWORD=
#
# The external server's address, read only with docker-compose.external-db.yml.
# MYSQL_HOST has no default: Compose refuses to start without it. It is seen
# from inside a container, so localhost is the container itself.
MYSQL_HOST=
MYSQL_PORT=3306

# --- Broker and cache: Valkey or Redis ----------------------------------------
# The Celery queue for bulk binds and the shared cache. The broker container
# runs Valkey; to run Redis instead:
#BROKER_IMAGE=redis:7-alpine
# Any image speaking the Redis protocol and providing redis-cli works; the
# application is the same either way. Switching loses only redirect counts not
# yet written to the database, so on a live system run
# `make manage ARGS="flush_counters"` first, then `make down && make up`.
#
# BROKER_PASSWORD is what clients must authenticate with. `make up` generates
# one when this file has no BROKER_PASSWORD line at all, and the broker
# container enforces it on every start (it keeps no data, so changing it is
# safe). With an external server it is that server's password instead: replace
# the generated value. A line set deliberately blank, BROKER_PASSWORD= , turns
# authentication off and is left blank.
#BROKER_PASSWORD=
#
# An external Valkey or Redis server, read only with
# docker-compose.external-broker.yml. BROKER_HOST has no default. Leave
# BROKER_USERNAME blank to log in as the server's default user with just the
# password; set it for a named account (ACL user), as managed services hand
# out. The queue and the cache use two database numbers, which must differ.
# For TLS set BROKER_SCHEME=rediss and BROKER_URL_OPTIONS=?ssl_cert_reqs=required
BROKER_HOST=
BROKER_PORT=6379
BROKER_USERNAME=
BROKER_QUEUE_DB=0
BROKER_CACHE_DB=1
BROKER_SCHEME=redis
BROKER_URL_OPTIONS=

# The administrator account `make up` creates. The password is generated
# and written back here if left blank, and printed on the run that creates the
# account. An account that already exists keeps its own password.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.org
DJANGO_SUPERUSER_PASSWORD=

# Largest number of ARKs one mint may create. 0 removes the cap. The mint form
# runs inside the web request, which gunicorn cuts off at 60 seconds, so a very
# large batch fails (and mints nothing) however high this is set.
MINT_MAX_PER_REQUEST=10000
